# Copy to mod.mwy at the project root. Paths are relative to this file. #

-> export : {
    -> packet : @"./docs/programs/packet.mwy"
}

# Foundational modules such as debug, strings, and tasks need no dependency entry. #
-> import : {}

-> build : {
    -> entry : "./docs/programs/main.mwy"
    -> profile : "debug"
}

# Remote dependency records belong under import, keyed by their local alias.
  Each record contains fetch and exactly one of hash, tag, or ref.
  hash is a full commit identifier; tag and ref resolve through mod.lock.
  See docs/reference/modules-and-ffi.md for resolution and lockfile rules.
#
