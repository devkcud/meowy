# Copy this template to mod.mwy in a project containing main.mwy and codec/header.mwy.
  Paths are relative to that project root, not to this guide directory.
  The worked packet project already includes its own manifest.
#

-> import : {
    -> aliases : {
        -> wire : "./codec"
    }
}

-> export : {
    -> packet : @"wire/header.mwy"
}

-> build : {
    -> entry : "./main.mwy"
    -> profile : "debug"
}

-> gatostyle : {
    -> preset : "structured"
}

-> lsp : {
    -> version : 1
}

# Package dependency records belong under import, beside the aliases table.
  A local package uses path; a local source directory goes in import.aliases.
  Remote dependencies contain fetch and exactly one of hash, tag, or ref.
  hash is a full commit identifier; tag and ref resolve through mod.lock.
  See mod.md beside this template for the full configuration guide.
#
