{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meowy:schema:common:1",
  "title": "meowy common schema 1",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "member": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000\\\\]+$"
    },
    "distribution": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": ["version", "digest"],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": ["path", "bytes", "digest"],
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["path", "digest", "start", "end"],
      "additionalProperties": false
    },
    "phase": {
      "enum": [
        "configuration",
        "resolution",
        "parsing",
        "compile_time",
        "type_checking",
        "ownership",
        "lowering",
        "linking",
        "execution",
        "supervision"
      ]
    },
    "fact": {
      "type": "object",
      "properties": {
        "area": {
          "enum": [
            "types",
            "ownership",
            "layout",
            "lowering",
            "tasks",
            "channels",
            "clocks"
          ]
        },
        "availability": {
          "enum": [
            "recorded",
            "derived_from_saved_inputs",
            "derived_from_recorded_events",
            "unavailable"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["area", "availability", "text"],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["code", "signal"],
      "additionalProperties": false
    },
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  }
}
