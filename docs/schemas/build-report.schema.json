{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meowy:schema:build-report:1",
  "title": "Meowy build-report schema 1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "meowy.build-report"
    },
    "version": {
      "const": 1
    },
    "status": {
      "enum": ["complete", "incomplete"]
    },
    "failed_phase": {
      "anyOf": [
        {
          "enum": ["checking", "lowering", "linking", "reporting"]
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "urn:meowy:schema:common:1#/$defs/file"
          }
        },
        "distribution": {
          "$ref": "urn:meowy:schema:common:1#/$defs/distribution"
        },
        "compiler_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "linker_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "runtime_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sysroot_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "profile": {
                  "enum": ["debug", "release"]
                },
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "optimize": {
                  "enum": ["none", "speed", "size", "smallest"]
                },
                "jobs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "debug_info": {
                  "enum": ["embedded", "separate", "none"]
                },
                "link": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "enum": ["platform", "shared", "static"]
                    },
                    "dead_strip": {
                      "type": "boolean"
                    },
                    "lto": {
                      "enum": ["off", "thin", "full"]
                    },
                    "icf": {
                      "enum": ["off", "safe"]
                    }
                  },
                  "required": ["mode", "dead_strip", "lto", "icf"],
                  "additionalProperties": false
                }
              },
              "required": [
                "profile",
                "cpu",
                "optimize",
                "jobs",
                "debug_info",
                "link"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "data_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": ["version", "digest"],
            "additionalProperties": false
          }
        },
        "unavailable": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "files",
        "distribution",
        "compiler_digest",
        "linker_digest",
        "target",
        "runtime_digest",
        "sysroot_digest",
        "cpu_features",
        "policy",
        "data_versions",
        "unavailable"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "anyOf": [
            {
              "$ref": "urn:meowy:schema:common:1#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "debug": {
          "type": "array",
          "items": {
            "$ref": "urn:meowy:schema:common:1#/$defs/file"
          }
        },
        "link_map": {
          "anyOf": [
            {
              "$ref": "urn:meowy:schema:common:1#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["report_path", "executable", "debug", "link_map"],
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "code",
                  "read_only",
                  "writable",
                  "zero_fill",
                  "unwind_diagnostic",
                  "debug"
                ]
              },
              "file_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "memory_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["name", "kind", "file_bytes", "memory_bytes"],
            "additionalProperties": false
          }
        }
      },
      "required": ["available", "reason", "items"],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["entry", "runtime", "native"]
              },
              "origin": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["id", "kind", "origin"],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "caller",
                  "initializer",
                  "cleanup",
                  "indirect_target",
                  "native_requirement",
                  "lookup_table"
                ]
              },
              "origin": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["from", "to", "kind", "origin"],
            "additionalProperties": false
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["roots", "edges", "unavailable"],
      "additionalProperties": false
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": ["elimination", "folding", "inlining", "specialization"]
          },
          "availability": {
            "enum": ["recorded", "unavailable"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["kind", "availability", "description"],
        "additionalProperties": false
      }
    },
    "runtime": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["loader", "shared_library", "data"]
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verified_on_host": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "kind",
          "path",
          "digest",
          "requirements",
          "verified_on_host"
        ],
        "additionalProperties": false
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "function": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["function", "bytes", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "version",
    "status",
    "failed_phase",
    "inputs",
    "artifacts",
    "sections",
    "retention",
    "transforms",
    "runtime",
    "stack"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "failed_phase": {
            "type": "null"
          },
          "artifacts": {
            "properties": {
              "executable": {
                "$ref": "urn:meowy:schema:common:1#/$defs/file"
              },
              "link_map": {
                "$ref": "urn:meowy:schema:common:1#/$defs/file"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "failed_phase": {
            "enum": ["checking", "lowering", "linking", "reporting"]
          }
        }
      }
    }
  ]
}
