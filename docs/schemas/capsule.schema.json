{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meowy:schema:capsule:1",
  "title": "meowy capsule schema 1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "meowy.capsule"
    },
    "version": {
      "const": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "occurrence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "phase": {
      "$ref": "urn:meowy:schema:common:1#/$defs/phase"
    },
    "distribution": {
      "$ref": "urn:meowy:schema:common:1#/$defs/distribution"
    },
    "compiler_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "host": {
      "type": "object",
      "properties": {
        "target": {
          "const": "x86_64-unknown-linux-gnu"
        },
        "cpu_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimum_kernel": {
          "type": "string",
          "minLength": 1
        },
        "minimum_glibc": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["target", "cpu_features", "minimum_kernel", "minimum_glibc"],
      "additionalProperties": false
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "namespace": {
      "enum": ["entry", "tests"]
    },
    "test": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "case_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "selectors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "base_seed": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "derived_seed": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "policy": {
              "type": "object",
              "properties": {
                "version": {
                  "const": 1
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "processes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "timeout_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "output_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "fail_fast": {
                  "type": "boolean"
                },
                "allow_empty": {
                  "type": "boolean"
                },
                "seed": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              },
              "required": [
                "version",
                "paths",
                "processes",
                "timeout_ms",
                "output_bytes",
                "fail_fast",
                "allow_empty",
                "seed"
              ],
              "additionalProperties": false
            },
            "phase": {
              "type": "string",
              "minLength": 1
            },
            "harness": {
              "anyOf": [
                {
                  "$ref": "urn:meowy:schema:common:1#/$defs/member"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "case_id",
            "selectors",
            "base_seed",
            "derived_seed",
            "policy",
            "phase",
            "harness"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "original_path": {
            "type": "string",
            "minLength": 1
          },
          "member": {
            "$ref": "urn:meowy:schema:common:1#/$defs/member"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "package",
          "path",
          "original_path",
          "member",
          "bytes",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "urn:meowy:schema:common:1#/$defs/member"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "executable": {
            "type": "boolean"
          }
        },
        "required": ["path", "bytes", "digest", "executable"],
        "additionalProperties": false
      }
    },
    "diagnostic": {
      "$ref": "urn:meowy:schema:common:1#/$defs/member"
    },
    "runner": {
      "anyOf": [
        {
          "$ref": "urn:meowy:schema:common:1#/$defs/member"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolchain_descriptor": {
      "anyOf": [
        {
          "$ref": "urn:meowy:schema:common:1#/$defs/member"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_log": {
      "anyOf": [
        {
          "$ref": "urn:meowy:schema:common:1#/$defs/member"
        },
        {
          "type": "null"
        }
      ]
    },
    "capture": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "closed",
            "external_dependencies",
            "incomplete",
            "unavailable"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["state", "reasons"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "closed"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "budgets": {
      "type": "object",
      "properties": {
        "input_limit": {
          "const": 268435456
        },
        "event_limit": {
          "const": 67108864
        },
        "output_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event_observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "first_omitted": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_limit",
        "event_limit",
        "output_limit",
        "input_observed",
        "event_observed",
        "output_observed",
        "first_omitted"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "values": {
          "type": "object",
          "properties": {
            "LANG": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "LC_ALL": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "LC_CTYPE": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "TZ": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["LANG", "LC_ALL", "LC_CTYPE", "TZ"],
          "additionalProperties": false
        },
        "omitted_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["values", "omitted_names"],
      "additionalProperties": false
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "version",
    "session",
    "occurrence",
    "phase",
    "distribution",
    "compiler_digest",
    "host",
    "command",
    "entry",
    "namespace",
    "test",
    "inputs",
    "inventory",
    "diagnostic",
    "runner",
    "toolchain_descriptor",
    "event_log",
    "capture",
    "budgets",
    "environment",
    "missing"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "namespace": {
            "const": "tests"
          }
        }
      },
      "then": {
        "properties": {
          "entry": {
            "type": "null"
          },
          "test": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture": {
            "properties": {
              "state": {
                "const": "closed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "runner": {
            "$ref": "urn:meowy:schema:common:1#/$defs/member"
          },
          "toolchain_descriptor": {
            "$ref": "urn:meowy:schema:common:1#/$defs/member"
          },
          "missing": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
