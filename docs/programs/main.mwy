debug : @"debug"
packet : @"./packet.mwy"

data <uint8[4]> : [1, 0, 1, 44]
header : packet.read_header(data.slice())

| header <packet.Truncated> | {
    debug.panic("Header needs {header.expected} bytes; got {header.actual}")
}

debug.print("Version: {header.version}")
debug.print("Flags: {header.flags}")
debug.print("Payload size: {header.payload_size}")
