channel : @"channel"
debug : @"debug"
memory : @"memory"
time : @"time"

produce <null> : (sender <channel.Sender<uint32>>) 'work {
    output := sender
    value <uint32> := 1

    'loop {
        | value > 4 | 'loop.leave()

        sent : output.send(value)
        | sent <channel.Rejected<uint32>> | 'work.leave()

        value = value + 1
        'loop.restart()
    }

    output.close()
}

consume <uint32> : (receiver <channel.Receiver<uint32>>) {
    input := receiver
    total <uint32> := 0

    'loop {
        item : input.receive()
        | item <channel.Closed> | 'loop.leave()

        total = total + item.value
        'loop.restart()
    }

    -> total
}

'main {
    endpoints : channel.bounded<uint32>(memory.heap, 2)
    | endpoints <memory.AllocationFailure> | {
        debug.print("Cannot allocate the channel")
        'main.leave()
    }

    deadline : time.after(time.Second)
    producer : >> produce(endpoints.sender)
    producer.deadline(deadline)
    consumer : >> consume(endpoints.receiver)
    consumer.deadline(deadline)

    produced : << producer
    consumed : << consumer

    | produced <error> | debug.print("Producer: {produced}")
    | consumed <error> | {
        debug.print("Consumer: {consumed}")
        'main.leave()
    }

    debug.print("Sum: {consumed}")
}
