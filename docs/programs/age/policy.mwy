strings : @"strings"

-> <Options> : <{
    minimum <uint8>
    maximum <uint8>
}>

-> describe <string> : (text <string>, options <Options>) 'result {
    age : strings.to_uint8(text)

    | age <error> | {
        'result -> "Enter a whole number from 0 to 255"
        'result.leave()
    }

    | age < options.minimum | {
        'result -> "Below the minimum age"
        'result.leave()
    }

    | age > options.maximum | {
        'result -> "Above the maximum age"
        'result.leave()
    }

    -> "Welcome"
}
