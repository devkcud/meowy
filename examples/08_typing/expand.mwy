<User> : <{
    id <string>;
    name <string>;
}>;

<Options> : <{
    theme <"dark"><"light">
}>

<UserWithOptions> : <{
    <User>;
    <Options>;
}> # <{
    id <string>;
    name <string>;
    theme <"dark"><"light">;
}> #

# A compilation-error will be thrown in case of collision. #

# You are still allowed to create named entries. #

<UserWithOptions> : <{
    user <User>;
    options <Options>;
}> # <{
    user <{
        id <string>;
        name <string>;
    }>;
    options <{
        theme <"dark"><"light">;
    }>;
}> #

<UserWithOptions> : <{
    user <User>;
    <Options>;
}> # <{
    user <{
        id <string>;
        name <string>;
    }>;
    theme <"dark"><"light">;
}> #
