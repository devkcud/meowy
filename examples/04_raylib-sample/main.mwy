rl : @"rl"

<Theme> : <"dark"><"light">
<Colors> : <{
    bg <rl.Color>
    fg <rl.Color>
}>

options : {
    -> title : "My Project"

    -> width : 800
    -> height : 600

    -> theme<Theme> := "dark"

    -> colors <Colors> : 'colors {
        | theme == "dark" | 'colors -> {
            -> bg : rl.BLACK
            -> fg : rl.RAYWHITE
        }
        | theme == "light" | 'colors -> {
            -> bg : rl.RAYWHITE
            -> fg : rl.LIGHTGRAY
        }
    }
}

# read the following as:

take the result of create_window.
dispatch an anonymous block against it.
inside that block, the dispatched value is `self`. #
win : rl.create_window({
    -> name : options.title
    -> width : options.width
    -> height : options.height
}).{
    | self <error> | @"debug".print.panic(self)
    -> self
}

rl.target_fps(60)

'game_loop {
    | win.should_close() | 'game_loop.leave()

    rl.begin_drawing()
    {
        rl.clear_background(options.colors.bg)
        rl.draw_text({
            -> text : "Congrats! You created your first window!"
            -> size : 20

            -> color : options.colors.fg

            -> x : 190
            -> y : 200
        })
    }
    rl.end_drawing()

    'game_loop.restart()
}
