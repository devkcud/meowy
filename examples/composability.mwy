connection : {
    cfg : << read_config()

    -> {
        token : authenticate(cfg)

        -> {
            conn : << connect(token)

            -> conn
        }
    }
}

# ------- #

connection : {
    -> << authenticate(<< read_config()).(connect) 
}

# ------- #

connection : {
    cfg : << read_config()
    token : authenticate(cfg)

    -> << token.(connect)
}

# ------- #

connection : {
    cfg : << read_config()

    -> authenticate(cfg).{
        -> << self.(connect)
    }
}

# ------- #

connection : {
    cfg : << read_config()

    -> << authenticate(cfg).(connect)
}

# ------- #

connection : {
    cfg : << read_config()

    -> << cfg.(authenticate).(connect)
}

# ------- #

connection : {
    -> << { -> << read_config() }.(authenticate).(connect)
}
