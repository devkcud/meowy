http : @"http"

&connection<any>
&connection.lazy()

i := 0
'loop {
    i = i + 1

    {
        work : &connection >1000> http.get("https://example.com")
        work.cancel()
    }

    | i != 10 | 'loop.restart()
}

&connection.iter().next() # instead of running everything async, groups can also be lazily iterable; each process only continues once you iterate over it, no need to wait! #
