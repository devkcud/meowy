&projects >> process()
<< &projects

# with marked groups, you can use their results afterwards without binding #

&projects[1].name # coming directly from the first process STARTED, not concluded #

#----------------#

# << means wait for and return  #

&projects >> process()
projects : << &projects

projects[1].name # same as the above #

# You can also wait on functions that might contain senders (>>) #

async_process : {
    -> >> process()
}

<< async_process()

# but this is EXTREMELY ill advised. you should always write code that won't make you regret it. #

async_process : {
    &ap >> process()

    -> << &ap
}

async_process()

# Note that these named groups are scoped to the current block. #
