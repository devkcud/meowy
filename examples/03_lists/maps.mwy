# There is no concept of maps, only runtime named positions. #

named <null[]> := [
    "apple" : {},
    "banana" : {},
    "cocoa" : {},
    "dragon" : {}
]

named[1] == named["apple"] # true #

named = named.remove<null[]>!<error>("apple") # <null[]> #

named[1] == named["banana"] # true #

named["eggplant"] = {}

named[4] == named["eggplant"] # true #

named[5] = {} # compile-time error #

# ---------------- #

items <string[]> := [
    "apple" : "🍎",
    "🍌",
    "dragon" : "🐉"
]

items[1] # "🍎" #
items["apple"] # "🍎" #
items[2] # "🍌" #
items[3] # "🐉" #
items["dragon"] # "🐉" #

# ---------------- #

# Every list can have unnamed and named positions. View them as aliases to data (emphasis on "data", not "index") instead of replacements. #
