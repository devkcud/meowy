d:@"debug"
<Row>:<{items<int32[2][2]>:=;side<int32[2]>:=;n<int32>:=}>
<R>:<{row<Row>}>
seed<int32[2]>:[0]
view:=&seed
old:view
first:=true
r<R>:'out{
    'loop{
        |first|{
            'out->row:{->items:=[[7]];->side:=[1];->n:=2}
            copy:row
            p:row.&!n
            row.items[{d.print("row");->1}][{row.side[1]=3;d.print("item");->1}]={d.print("rhs");->8}
            view=row.&side
            *p=9
            d.print(copy.items[1][1])
            first=false
            'loop.restart()
        }
        d.print(view[1])
        d.print(old[1])
    }
}
view=&seed
d.print(r.row.items[1][1])
d.print(r.row.n)
