#!| Public counter facade: [[inc]] and [[<Count>]]. |!#
counter:@"./counter.mwy"
#| Counter type from [[<counter.Count>]]. |#
-><Count>:<counter.Count>
#| Increment through [[counter.inc]]. |#
->inc<(int32)->int32>:counter.inc
#| Initial value from [[counter.defaults.start]]. |#
->start:counter.defaults.start
