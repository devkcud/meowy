d:@"debug"
<Row>:<{n<int32>;label<string>}>
<R>:<{row<Row>}>
first:=true
i:=0
r<R>:'out{
    'loop{
        |first|{
            'out->row:{d.print("init");->n:7;->label:"ready"}
            first=false
        }
        i=i+1
        |i<3|'loop.restart()
    }
}
d.print(r.row.n)
d.print(r.row.label)
