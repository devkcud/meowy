#!| A small checked API for [[add]]. |!#
d : @"debug"

#||
Adds [[left]] and [[right]] as [[<int32>]] values.

```meowy run
d : @"debug"
d.print(2 + 3)
```

```output
5
```
||#
add <int32> : (
    #| First count. |#
    left <int32>,
    #| Second count. |#
    right <int32>
) {
    -> left + right
}

d.print(add(2, 3))
