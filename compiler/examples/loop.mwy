debug : @"debug"

sum <int32> : (limit <int32>) 'result {
    total := 0
    next := 1
    'loop {
        | next > limit | {
            'result -> total
            'result.leave()
        }
        total = total + next
        next = next + 1
        'loop.restart()
    }
}

debug.print(sum(100))
