debug : @"debug"

initial <int32> : () { debug.print("init"); -> 1 }
result : {
    -> count := initial()
    before : count
    count = count + 1
    debug.print(before)
    debug.print(count)
    -> items <int32[3]> := [1, 2]
    items[2] = 9
}
debug.print(result.count)
debug.print(result.items[2])
